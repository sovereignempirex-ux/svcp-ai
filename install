#!/usr/bin/env bash
#
# Installs SVPC AI on Linux and macOS from a GitHub release.
#
# The archive layout is produced by .goreleaser.yml, and the two have to agree:
# the names below are the names goreleaser writes.
set -euo pipefail

APP=svpc
REPO="sovereignempirex-ux/svcp-ai"

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
ORANGE='\033[38;2;255;140;0m'
NC='\033[0m'

print_message() {
  local color="$1"
  shift
  echo -e "${color}$*${NC}"
}

# ── Platform ────────────────────────────────────────────────────
os=$(uname -s | tr '[:upper:]' '[:lower:]')
[[ "$os" == "darwin" ]] && os="mac"

arch=$(uname -m)
case "$arch" in
  x86_64|amd64) arch="x86_64" ;;
  aarch64|arm64) arch="arm64" ;;
  # 32-bit is not built. The release has no 386 target, so accepting the
  # architecture here only moved the failure from a clear message at the start to
  # a download error a long way in, with nothing to tell the user what to do.
  i386|i686) print_message "$RED" "32-bit is not supported$NC"; exit 1 ;;
  *) print_message "$RED" "Unsupported architecture: $arch$NC"; exit 1 ;;
esac

case "$os" in
  mac) [[ "$arch" == "x86_64" || "$arch" == "arm64" ]] || {
    print_message "$RED" "macOS supports x86_64 and arm64 only$NC"; exit 1; } ;;
  linux) print_message "$GREEN" "Installing $APP for $os/$arch$NC" ;;
  *) print_message "$RED" "Unsupported OS: $os$NC"; exit 1 ;;
esac

# goreleaser names archives "<app>-<os>-<arch>[.tar.gz]".
archive="$APP-$os-$arch.tar.gz"

# ── Already installed? ──────────────────────────────────────────
if command -v "$APP" >/dev/null 2>&1; then
  # The version is only used for a message, so a binary that will not run — a
  # wrong architecture, a truncated file — must not stop the install. Without
  # the fallback the pipeline's non-zero status reaches `set -e` and the script
  # dies here with nothing printed.
  installed_version=$("$APP" --version 2>/dev/null | tr -d '\r' | head -n 1) || installed_version=""
  print_message "$GREEN" "Found $APP ${installed_version:-of unknown version} at $(command -v "$APP")$NC"
  if [[ -z "${VERSION:-}" && "$installed_version" != *"dev"* ]]; then
    print_message "$YELLOW" "Re-run with VERSION=<tag> to install a specific release.$NC"
    exit 0
  fi
fi

# ── Resolve the download ────────────────────────────────────────
if [[ -z "${VERSION:-}" ]]; then
  # The reply is fetched whole and parsed afterwards, never piped into awk.
  # Piping makes the install depend on a race: awk stops at the first match and
  # closes the pipe, so curl fails on the write with error 23, which `set -e`
  # turns into a fatal error. A release body is several kilobytes, so the only
  # question was whether the reader or the writer won.
  if ! reply=$(curl -sSf "https://api.github.com/repos/$REPO/releases/latest"); then
    print_message "$RED" "Could not reach GitHub to find the latest release.$NC"
    print_message "$YELLOW" "Check the network, or pass VERSION=<tag> to skip this.$NC"
    exit 1
  fi

  # Matched by the shell rather than by a child process, so there is no pipe to
  # break. The leftmost occurrence is the field itself; a later one could only
  # be release notes quoting it.
  latest=""
  if [[ "$reply" =~ \"tag_name\"[[:space:]]*:[[:space:]]*\"v?([^\"]+)\" ]]; then
    latest="${BASH_REMATCH[1]}"
  fi
  # A tag that does not begin with a digit means the field was not found, and
  # building a download URL out of it would fail later and less clearly.
  if [[ ! "$latest" =~ ^[0-9] ]]; then
    print_message "$RED" "Could not read the latest release from GitHub.$NC"
    print_message "$YELLOW" "Pass VERSION=<tag> to install a specific release.$NC"
    exit 1
  fi
else
  latest="${VERSION#v}"
fi

url="https://github.com/$REPO/releases/download/v${latest}/${archive}"
print_message "$GREEN" "Downloading ${ORANGE}$APP${GREEN} ${YELLOW}v${latest}${GREEN}...$NC"

# ── Install ─────────────────────────────────────────────────────
# A hidden directory rather than /usr/local, so the script needs no root and
# does not collide with a package manager.
INSTALL_DIR="$HOME/.svpc/bin"
mkdir -p "$INSTALL_DIR"

tmp=$(mktemp -d)
trap 'rm -rf "$tmp"' EXIT

if ! curl -# -Lf "$url" -o "$tmp/$archive"; then
  print_message "$RED" "Download failed: $url$NC"
  exit 1
fi

tar -xzf "$tmp/$archive" -C "$tmp"

if [[ ! -f "$tmp/$APP" ]]; then
  print_message "$RED" "The archive did not contain a '$APP' binary.$NC"
  exit 1
fi

chmod +x "$tmp/$APP"
mv -f "$tmp/$APP" "$INSTALL_DIR/$APP"
print_message "$GREEN" "Installed $APP $latest to $INSTALL_DIR$NC"

# ── PATH ────────────────────────────────────────────────────────
XDG_CONFIG_HOME=${XDG_CONFIG_HOME:-$HOME/.config}

case "$(basename "${SHELL:-sh}")" in
  fish)  config_files=("$HOME/.config/fish/config.fish") ;;
  zsh)   config_files=("$HOME/.zshrc" "$HOME/.zshenv" "$XDG_CONFIG_HOME/zsh/.zshrc" "$XDG_CONFIG_HOME/zsh/.zshenv") ;;
  bash)  config_files=("$HOME/.bashrc" "$HOME/.bash_profile" "$HOME/.profile") ;;
  *)     config_files=("$HOME/.profile" "$HOME/.bash_profile" "$HOME/.bashrc") ;;
esac

if [[ ":$PATH:" != *":$INSTALL_DIR:"* ]]; then
  target=""
  for file in "${config_files[@]}"; do
    [[ -f "$file" ]] && { target="$file"; break; }
  done

  if [[ -n "$target" && -w "$target" ]]; then
    {
      echo ""
      echo "# SVPC AI"
      if [[ "$target" == *fish* ]]; then
        echo "fish_add_path $INSTALL_DIR"
      else
        echo "export PATH=\"$INSTALL_DIR:\$PATH\""
      fi
    } >> "$target"
    print_message "$GREEN" "Added $INSTALL_DIR to PATH in $target$NC"
    print_message "$YELLOW" "Open a new shell, or run: source $target$NC"
  else
    print_message "$YELLOW" "Add this to your PATH:$NC"
    print_message "$GREEN" "  export PATH=\"$INSTALL_DIR:\$PATH\"$NC"
  fi
fi

# ── Done ────────────────────────────────────────────────────────
print_message ""
print_message "$GREEN" "SVPC AI $latest is installed.$NC"
print_message "$YELLOW" "  $APP --gui          open the desktop window$NC"
print_message "$YELLOW" "  $APP                open the terminal interface$NC"
print_message "$YELLOW" "  $APP --serve 0.0.0.0   let a phone connect to it$NC"
print_message "$YELLOW" "  $APP --help         everything else$NC"
