# Binaries for programs and plugins
*.exe
*.exe~
*.dll
*.so
*.dylib

# Test binary, built with `go test -c`
*.test

# Output of the go coverage tool, specifically when used with LiteIDE
*.out

# Dependency directories (remove the comment below to include it)
# vendor/

# Go workspace file
go.work

# IDE specific files
.idea/
.vscode/
*.swp
*.swo

# OS specific files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
*.log

# Binary output directory
/bin/
/dist/

# Local environment variables
.env
.env.local

.opencode/

opencode
opencode.md

# SVPC AI build and packaging artifacts
# resource.syso is generated from the icon and versioninfo.json by goversioninfo
# at build time; it must not be committed because it differs per build host.
/resource.syso
*.syso

# Signing material must never reach the repository.
/*.cer
/*.pfx
/*.p12
/*.pem

# Local application data: sessions, logs and generated images.
/.svpc/
/dist/

# A pristine copy of the upstream project, kept alongside for reference.
/opencode-main/
/opencode-main.zip

# Android build output: the intermediate tree and the signing key never belong
# in the repository, and the key especially should not.
/android/build/
/android/dist/
# The signing key is deliberately outside build/ so a clean does not replace it.
# It is still never committed: back it up out of the repository.
/android/keystore/
*.keystore
*.jks
